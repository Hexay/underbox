// underbox replacement for Valve's morph.fxc. Only skinning_cs calls it (with D_MORPH declared and
// g_nMorphTextureAtlasWidth defined first); other includers get the declarations only.
#ifndef MORPH_FXC
#define MORPH_FXC

#include "transform_buffer.fxc"

// Where this instance's morph composite is (see Morph below), as managed's SetMorphSubrect stores it.
struct MorphSubrectData_t
{
	float4 vAtlasRect;
};

#ifdef D_MORPH
MorphSubrectData_t CalculateMorphSubrectData( uint nBaseSlot )
{
	TransformBufferData_t d = g_TransformBuffer[ nBaseSlot + 1 ];
	MorphSubrectData_t o;
	o.vAtlasRect = float4( d.Row0.z, d.Row0.w, d.Row1.w, d.Row2.w );
	return o;
}

// The renderer's composite (engine2 render/skin/morphs.rs): per vertex a position delta (w:
// wrinkle) and a normal delta; vAtlasRect.x is the instance's first float4, .y how many it has.
StructuredBuffer<float4> g_MorphComposite < Attribute( "MorphComposite" ); >;

void Morph( inout float3 vPosition, inout float3 vNormal, inout float flWrinkle, uint nVertex, MorphSubrectData_t data )
{
	if ( 2 * nVertex + 1 >= uint( data.vAtlasRect.y ) )
		return;
	uint nAt = uint( data.vAtlasRect.x ) + 2 * nVertex;
	float4 vDelta = g_MorphComposite[ nAt ];
	vPosition += vDelta.xyz;
	flWrinkle += vDelta.w;
	vNormal += g_MorphComposite[ nAt + 1 ].xyz;
}
#endif

#endif // MORPH_FXC
