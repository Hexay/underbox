// underbox replacement for Valve's sheet_sampling.fxc (sprite-sheet sequences, Sheet.hlsl).
// TODO: decode the sheet texture (no GPU sheet layout yet); every sequence is one full-texture frame.
#ifndef SHEET_SAMPLING_FXC
#define SHEET_SAMPLING_FXC

struct SheetDataSamplerParams_t
{
	float m_flSheetTextureBaseV;
	float m_flOOSheetTextureWidth;
	float m_flOOSheetTextureHeight;
	float m_flSheetTextureWidth;
	float m_flSheetSequenceCount;
	float m_flSequenceAnimationTimescale;
	float m_flSequenceIndex;
	float m_flSequenceAnimationTime;
};

// Frame bounds: xy UV min, zw UV max.
struct SheetDataSamplerOutput_t
{
	float4 m_vFrame0Bounds;
	float4 m_vFrame1Bounds;
	float m_flAnimationBlendValue;
};

SheetDataSamplerOutput_t SampleSheetData( SamplerState s, Texture2D tSheet, SheetDataSamplerParams_t params, bool bClamp )
{
	SheetDataSamplerOutput_t o;
	o.m_vFrame0Bounds = float4( 0, 0, 1, 1 );
	o.m_vFrame1Bounds = float4( 0, 0, 1, 1 );
	o.m_flAnimationBlendValue = 0.0;
	return o;
}

#endif // SHEET_SAMPLING_FXC
