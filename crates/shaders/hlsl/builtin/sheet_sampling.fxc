// underbox replacement for Valve's sheet_sampling.fxc (sprite-sheet sequences, Sheet.hlsl).
// Reads our metadata texture; its layout: crates/engine2/src/render/sheet_meta.rs.
#ifndef SHEET_SAMPLING_FXC
#define SHEET_SAMPLING_FXC

struct SheetDataSamplerParams_t
{
	float m_flSheetTextureBaseV;
	float m_flOOSheetTextureWidth;
	float m_flOOSheetTextureHeight;
	float m_flSheetTextureWidth;
	float m_flSheetSequenceCount;
	float m_flSequenceAnimationTimescale;
	float m_flSequenceIndex;
	float m_flSequenceAnimationTime;
};

// Frame bounds: xy UV min, zw UV max.
struct SheetDataSamplerOutput_t
{
	float4 m_vFrame0Bounds;
	float4 m_vFrame1Bounds;
	float m_flAnimationBlendValue;
};

SheetDataSamplerOutput_t SampleSheetData( SamplerState s, Texture2D tSheet, SheetDataSamplerParams_t params, bool bClamp )
{
	SheetDataSamplerOutput_t o;
	o.m_vFrame0Bounds = float4( 0, 0, 1, 1 );
	o.m_vFrame1Bounds = o.m_vFrame0Bounds;
	o.m_flAnimationBlendValue = 0.0;
	if ( params.m_flSheetSequenceCount < 1.0 || params.m_flOOSheetTextureHeight <= 0.0 )
		return o;

	float flSequence = clamp( floor( params.m_flSequenceIndex ), 0.0, params.m_flSheetSequenceCount - 1.0 );
	int nRow = int( params.m_flSheetTextureBaseV / params.m_flOOSheetTextureHeight + flSequence );
	float4 vHeader = tSheet.Load( int3( 0, nRow, 0 ) );
	int nFrames = int( vHeader.x );
	if ( nFrames < 1 )
		return o;

	bool bClampTime = bClamp || vHeader.z != 0.0;
	float flTotal = vHeader.y;
	float flTime = params.m_flSequenceAnimationTime * params.m_flSequenceAnimationTimescale;
	if ( flTotal <= 0.0 )
		flTime = 0.0;
	else if ( bClampTime )
		flTime = clamp( flTime, 0.0, flTotal );
	else
		flTime -= flTotal * floor( flTime / flTotal );

	int nFrame = 0;
	float4 vTime = tSheet.Load( int3( 1 + nFrames, nRow, 0 ) );
	[loop]
	for ( int i = 1; i < nFrames; i++ )
	{
		float4 vNext = tSheet.Load( int3( 1 + nFrames + i, nRow, 0 ) );
		if ( vNext.x > flTime )
			break;
		nFrame = i;
		vTime = vNext;
	}
	int nNext = nFrame + 1 < nFrames ? nFrame + 1 : ( bClampTime ? nFrame : 0 );

	o.m_vFrame0Bounds = tSheet.Load( int3( 1 + nFrame, nRow, 0 ) );
	o.m_vFrame1Bounds = tSheet.Load( int3( 1 + nNext, nRow, 0 ) );
	o.m_flAnimationBlendValue = vTime.y > 0.0 ? saturate( ( flTime - vTime.x ) / vTime.y ) : 0.0;
	return o;
}

#endif // SHEET_SAMPLING_FXC
