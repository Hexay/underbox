[submodule "third_party/GameNetworkingSockets"]
	path = third_party/GameNetworkingSockets
	url = https://github.com/ValveSoftware/GameNetworkingSockets.git
[submodule "third_party/box2d"]
	path = third_party/box2d
	url = https://github.com/erincatto/box2d.git
[submodule "third_party/protobuf"]
	path = third_party/protobuf
	url = https://github.com/protocolbuffers/protobuf.git
	shallow = true
[submodule "third_party/steam-audio"]
	path = third_party/steam-audio
	url = https://github.com/ValveSoftware/steam-audio.git
	shallow = true
[submodule "third_party/pffft"]
	path = third_party/pffft
	url = https://github.com/marton78/pffft.git
